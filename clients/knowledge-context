#!/bin/sh
# Session-start context for non-Claude agents (Codex, agy hooks): the knowledge server's startup context (shared
# CLAUDE.md, project CLAUDE.md, memory index) for the current directory, using the plugin's context.sh, plus the
# docs mirror of a folder with .knowledge-project (docs-sync.py; reads the hook's JSON on stdin).
# Full paths: Codex starts hooks and helpers with a bare PATH (no ~/.local/bin).
# VAULT_NAME "-" takes the token from KNOWLEDGE_TOKEN (any machine with a clone of this repo; Linux/macOS).
# Usage: knowledge-context <VAULT_NAME> <part>   one part as plain text
#        knowledge-context <VAULT_NAME> all      every part as one Codex SessionStart JSON answer; Codex rejects the
#                                                 context when several SessionStart hooks are registered (openai/codex#45999)
#        knowledge-context <VAULT_NAME> agy      every part as one agy SessionStart answer (injectSteps)
if [ "${1:?vault name or -}" = - ]; then token=$KNOWLEDGE_TOKEN; else token=$(/home/user/.local/bin/secret "$1"); fi
part=${2:-1}
hooks=$(dirname "$(readlink -f "$0")")/../plugin/hooks
run() { CLAUDE_PLUGIN_OPTION_TOKEN=$token CLAUDE_PROJECT_DIR=$PWD sh $hooks/context.sh "$1"; }
if [ "$part" != all ] && [ "$part" != agy ]; then run "$part"; exit 0; fi
{
    KNOWLEDGE_TOKEN=$token python3 $hooks/docs-sync.py  # silent unless the mirror fails
    n=1; while [ $n -le 9 ]; do out=$(run $n); [ -n "$out" ] || break; printf '%s\n\n' "$out"; n=$((n + 1)); done
} | python3 -c 'import json, sys
text = sys.stdin.read()
print(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": text}}]} if sys.argv[1] == "agy" else
                 {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))' "$part"
