{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.local/bin/knowledge-context KNOWLEDGE_TOKEN_CODEX all",
            "timeout": 30,
            "additionalContextLimit": 60000
          }
        ]
      }
    ]
  }
}
