#!/usr/bin/env python3
"""Secrets for Claude: one command, always unlocked. Source of truth = a Vaultwarden/Bitwarden organisation and
collection (default "Homelab"/"Homelab") shared with a dedicated account, so the owner sees and edits the same items
in their own Bitwarden app while the automation account cannot see their personal vault.

  secret NAME                 print the value (use it inside a command: sshpass -p "$(secret NAME)" ssh ...)
  secret ls                   list the names
  secret set NAME [--user U] [--url URL] [--note TEXT]   value from stdin; creates or updates the item,
                                                         then refreshes the secret-guard hashes (token.py push-secrets)
  secret rm NAME               delete the item (it stays in the organisation's trash in Vaultwarden)
  secret tsv                  value<TAB>NAME for every item (redaction lists, knowledge token.py push-secrets)
  secret import-tsv FILE      one-time import of a value<TAB>NAME file (skips existing names)
  secret scrub [--apply] FILE...   replace every vault value in notes by ‹secret:NAME› (dry run without --apply)

Reads go through rbw (agent keeps the vault unlocked; its pinentry reads the master password from a systemd user
credential, so it unlocks itself after a reboot). Writes go through the official bw CLI, because rbw cannot write to
an organisation. Notes refer to a secret as ‹secret:NAME›.

Config (env): SECRET_BW_DIR (bw data dir), SECRET_CRED (systemd user credential with the master password),
SECRET_ORG and SECRET_COLLECTION.
"""
import base64
import json
import os
import re
import subprocess
import sys
from pathlib import Path

def tool(name: str) -> str:
    """Find rbw/bw even when ~/.local/bin is not on PATH (services, cron and tmux sessions started at boot)."""
    import shutil
    for cand in (shutil.which(name), Path.home() / ".local/bin" / name, Path("/usr/local/bin") / name):
        if cand and Path(cand).exists():
            return str(cand)
    die(f"{name} not found (install it in ~/.local/bin)")


BW_DIR = Path(os.environ.get("SECRET_BW_DIR", Path.home() / ".config/bw-homelab"))
CRED = Path(os.environ.get("SECRET_CRED", Path.home() / ".config/knowledge-server/vw-master.cred"))
ORG = os.environ.get("SECRET_ORG", "Homelab")
COLLECTION = os.environ.get("SECRET_COLLECTION", "Homelab")


def die(msg: str):
    sys.exit(f"secret: {msg}")


def rbw(*args: str) -> str:
    r = subprocess.run([tool("rbw"), *args], capture_output=True, text=True)
    if r.returncode != 0:
        if "locked" in r.stderr.lower() or "unlock" in r.stderr.lower():
            subprocess.run([tool("rbw"), "unlock"], capture_output=True)  # the pinentry shim supplies the password
            r = subprocess.run([tool("rbw"), *args], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"rbw {' '.join(args[:1])} failed: {r.stderr.strip() or r.stdout.strip()} "
                "(vault locked? run `rbw unlock`; unknown name? run `secret ls`)")
    return r.stdout


def push_hashes():
    """Refresh the secret-guard hash lists after a change, else a new secret is not masked until someone pushes by hand."""
    token_py = Path(__file__).resolve().parent.parent / "token.py"
    if not token_py.exists():
        return
    if subprocess.run([sys.executable, str(token_py), "push-secrets"]).returncode != 0:
        die(f"vault updated, but the secret-guard hashes were not: run `{token_py} push-secrets`")


def bw_session() -> dict:
    env = {**os.environ, "BITWARDENCLI_APPDATA_DIR": str(BW_DIR)}
    pw = subprocess.run(["systemd-creds", "--user", "decrypt", "--name=vw-master", str(CRED), "-"],
                        check=True, capture_output=True, text=True).stdout
    env["BW_PASSWORD"] = pw
    sess = subprocess.run([tool("bw"), "unlock", "--passwordenv", "BW_PASSWORD", "--raw"], env=env, capture_output=True, text=True)
    env.pop("BW_PASSWORD")
    if sess.returncode != 0 or not sess.stdout.strip():
        die(f"bw unlock failed: {sess.stderr.strip()}")
    env["BW_SESSION"] = sess.stdout.strip()
    subprocess.run([tool("bw"), "sync"], env=env, capture_output=True)
    return env


def bw(env: dict, *args: str) -> str:
    r = subprocess.run([tool("bw"), *args], env=env, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"bw {args[0]} failed: {r.stderr.strip()}")
    return r.stdout


def ids(env: dict) -> tuple[str, str]:
    org = next((o["id"] for o in json.loads(bw(env, "list", "organizations")) if o["name"] == ORG), None)
    col = next((c["id"] for c in json.loads(bw(env, "list", "collections")) if c["name"] == COLLECTION), None)
    if not org or not col:
        die(f"organisation/collection {ORG}/{COLLECTION} not visible for this account (invited and confirmed?)")
    return org, col


def put(env: dict, org: str, col: str, name: str, value: str, user=None, url=None, note=None, existing=None):
    if existing:
        item = json.loads(bw(env, "get", "item", existing["id"]))
        item["login"]["password"] = value
        if user is not None:
            item["login"]["username"] = user
        if note is not None:
            item["notes"] = note
        bw(env, "edit", "item", existing["id"], base64.b64encode(json.dumps(item).encode()).decode())
        return
    item = {"organizationId": org, "collectionIds": [col], "folderId": None, "type": 1, "name": name,
            "notes": note, "favorite": False, "reprompt": 0,
            "login": {"username": user, "password": value, "totp": None,
                      "uris": [{"match": None, "uri": url}] if url else []}}
    bw(env, "create", "item", base64.b64encode(json.dumps(item).encode()).decode())


def org_items(env: dict, org: str) -> dict:
    return {i["name"]: i for i in json.loads(bw(env, "list", "items", "--organizationid", org))}


# Login context in English and Dutch notes ("wachtwoord" = password, "inlog" = login, "gebruiker" = user).
CRED_CONTEXT = re.compile(r"pass|wachtwoord|\bww\b|login|inlog|\buser|gebruiker|ssh|sudo|credential|account|auth|token|"
                          r"\bpw\b|\broot\b|\badmin\b", re.I)
DICT = Path("/usr/share/dict/words")
WORDS = {w.strip().lower() for w in DICT.read_text(errors="ignore").split()} if DICT.exists() else set()


def wordlike(value: str) -> bool:
    """A value that is also an ordinary word ("sunflower") needs login context before it is replaced."""
    return value.lower() in WORDS


def scrub(text: str, values: dict[str, str]) -> tuple[str, int, list[str]]:
    """Replace vault values by ‹secret:NAME› where they stand on their own (not inside a longer word). Values that look
    like an ordinary word ("sunflower") are only replaced on a line that is about logging in; other hits are reported."""
    count, skipped = 0, []
    for value in sorted(values, key=len, reverse=True):  # longest first, so a value inside another one is not cut
        if len(value) < 6:
            continue
        out, pos = [], 0
        while (i := text.find(value, pos)) >= 0:
            j = i + len(value)
            line_start, line_end = text.rfind("\n", 0, i) + 1, text.find("\n", j)
            line = text[line_start:line_end if line_end >= 0 else None]
            alone = not (i > 0 and (text[i - 1].isalnum() or text[i - 1] == "_")) and not (j < len(text) and (text[j].isalnum() or text[j] == "_"))
            after_user = i > 0 and text[i - 1] == "/" and text[max(0, i - 20):i - 1].split()[-1:] != []  # user/value
            if alone and (not wordlike(value) or after_user or CRED_CONTEXT.search(line)):
                out.append(text[pos:i] + f"‹secret:{values[value]}›")
                count += 1
            else:
                out.append(text[pos:j])
                if alone:
                    skipped.append(f"{values[value]}: {line.strip().replace(value, '<VALUE>')[:120]}")
            pos = j
        text = "".join(out) + text[pos:]
    return text, count, skipped


def main(argv: list[str]):
    if not argv or argv[0] in ("-h", "--help"):
        sys.exit(__doc__)
    cmd = argv[0]
    if cmd == "ls":
        print(rbw("ls"), end="")
    elif cmd == "tsv":
        for name in rbw("ls").split("\n"):
            if name:
                print(f"{rbw('get', name).rstrip(chr(10))}\t{name}")
    elif cmd == "set" and len(argv) >= 2:
        name, opts = argv[1], dict(zip(argv[2::2], argv[3::2]))
        value = sys.stdin.read().rstrip("\n")
        if not value:
            die("no value on stdin")
        env = bw_session()
        org, col = ids(env)
        put(env, org, col, name, value, opts.get("--user"), opts.get("--url"), opts.get("--note"), org_items(env, org).get(name))
        rbw("sync")
        print(f"saved {name}")
        push_hashes()
    elif cmd == "rm" and len(argv) == 2:
        env = bw_session()
        org, _ = ids(env)
        item = org_items(env, org).get(argv[1])
        if not item:
            die(f"no item named {argv[1]}")
        bw(env, "delete", "item", item["id"])
        rbw("sync")
        print(f"deleted {argv[1]}")
        push_hashes()
    elif cmd == "scrub" and len(argv) >= 2:
        apply = "--apply" in argv
        values = {}
        for line in rbw("ls").split("\n"):
            if line:
                values.setdefault(rbw("get", line).rstrip("\n"), line)
        total = 0
        for f in [a for a in argv[1:] if a != "--apply"]:
            text = Path(f).read_text(encoding="utf-8")
            new, n, skipped = scrub(text, values)
            for s_ in skipped:
                print(f"  kept (no login context) {f}: {s_}")
            if n:
                total += n
                print(f"{'replaced' if apply else 'would replace'} {n} in {f}")
                if apply:
                    Path(f).write_text(new, encoding="utf-8")
        print(f"{'replaced' if apply else 'would replace'} {total} value(s) in total" + ("" if apply else " (dry run; add --apply)"))
    elif cmd == "import-tsv" and len(argv) == 2:
        env = bw_session()
        org, col = ids(env)
        have = org_items(env, org)
        added = skipped = 0
        for line in open(argv[1], encoding="utf-8"):
            if line.startswith("#") or "\t" not in line:
                continue
            value, name = line.rstrip("\n").split("\t", 1)
            name = name.strip()
            if not name or name.startswith("‹") or not value.strip():
                continue  # unnamed entries and e-mail addresses are redaction rules, not secrets
            if name in have:
                skipped += 1
                continue
            put(env, org, col, name, value, note="Imported from a secrets list")
            have[name] = {"id": ""}
            added += 1
        rbw("sync")
        print(f"imported {added}, already there {skipped}")
    elif len(argv) == 1 and not cmd.startswith("-"):
        print(rbw("get", cmd), end="")
    else:
        sys.exit(__doc__)


def selftest():
    vals = {"Sup3rSecret99": "DB_PASSWORD", "sunflower": "PI_PASSWORD", "abc12345678": "A", "abc123456789": "B"}
    t = ("db Sup3rSecret99 and xSup3rSecret99 stays\nssh pi/sunflower\na sunflower pi board\n"
         "abc123456789 abc12345678\n")
    new, n, skipped = scrub(t, vals)
    assert "db ‹secret:DB_PASSWORD› and xSup3rSecret99 stays" in new and "pi/‹secret:PI_PASSWORD›" in new, new
    assert "a sunflower pi board" in new and len(skipped) == 1 and "‹secret:B› ‹secret:A›" in new and n == 4, (new, n)
    print("ok")


if __name__ == "__main__":
    selftest() if sys.argv[1:] == ["--selftest"] else main(sys.argv[1:])
