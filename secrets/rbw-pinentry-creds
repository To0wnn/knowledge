#!/usr/bin/env python3
"""Pinentry for rbw that answers with the master password from a systemd user credential (SECRET_CRED).

The password is stored encrypted (systemd-creds --user, bound to this user on this machine), so the vault unlocks by
itself after a reboot and the automation can always read its secrets; nothing lies on disk in plain text.
Speaks the small part of the Assuan pinentry protocol that rbw uses (GETPIN, BYE, everything else OK).
"""
import os
import subprocess
import sys
from pathlib import Path

CRED = Path(os.environ.get("SECRET_CRED", Path.home() / ".config/knowledge-server/vw-master.cred"))


def password() -> str:
    return subprocess.run(["systemd-creds", "--user", "decrypt", "--name=vw-master", str(CRED), "-"],
                          check=True, capture_output=True, text=True).stdout


def escape(s: str) -> str:  # Assuan data lines: % CR LF must be percent-encoded
    return s.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def main():
    out = sys.stdout
    out.write("OK rbw-pinentry-creds\n"); out.flush()
    for line in sys.stdin:
        cmd = line.strip().split(" ", 1)[0].upper()
        if cmd == "GETPIN":
            try:
                out.write(f"D {escape(password())}\nOK\n")
            except Exception as e:  # rbw then reports that unlocking failed
                out.write(f"ERR 83886179 {e}\n")
        elif cmd == "BYE":
            out.write("OK\n"); out.flush(); return
        else:
            out.write("OK\n")
        out.flush()


if __name__ == "__main__":
    main()
