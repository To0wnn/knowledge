{
  "description": "Codex (Windows: hooks run in the session shell, usually PowerShell, so no %VAR%; Codex fills in ${PLUGIN_ROOT} itself): the knowledge context at session start (one handler: with several Codex drops the context, openai/codex#45999), the docs mirror after apply_patch, tasks handed over during the session before each prompt, waking the other agents on this machine after a knowledge write, the session log (SessionEnd may take at most 3 s)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" context codex",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" context codex",
            "timeout": 30,
            "additionalContextLimit": 60000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" docs-sync",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" docs-sync",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__.*knowledge_(edit|write|new_memo)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" wake codex",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" wake codex",
            "timeout": 40
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" tasks codex",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" tasks codex",
            "timeout": 8
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" session-log",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" session-log",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"${PLUGIN_ROOT}/hooks/agent_hooks.py\" session-log",
            "commandWindows": "cmd /d /c call \"${PLUGIN_ROOT}\\python3.cmd\" -X utf8 \"${PLUGIN_ROOT}\\hooks\\agent_hooks.py\" session-log",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
