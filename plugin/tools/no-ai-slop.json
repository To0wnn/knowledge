    {"run": ["npx", "-y", "skills@latest", "remove", "no-ai-slop", "--global", "--yes", "--agent", "codex"], "agent": "codex", "env": {"DO_NOT_TRACK": "1"}},
    {"run": ["npx", "-y", "skills@latest", "remove", "no-ai-slop", "--global", "--yes", "--agent", "antigravity-cli"], "agent": "agy", "env": {"DO_NOT_TRACK": "1"}}
  ]
