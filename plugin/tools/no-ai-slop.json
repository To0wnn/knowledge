    {"run": ["npx", "-y", "skills@latest", "add", "petergyang/no-ai-slop", "--skill", "no-ai-slop", "--global", "--yes", "--copy", "--agent", "antigravity-cli"], "agent": "agy", "env": {"DO_NOT_TRACK": "1"}}
  ],
  "check": [
    {"run": ["npx", "-y", "skills@latest", "list", "--global", "--json"], "expect": "\"name\": \"no-ai-slop\"", "env": {"DO_NOT_TRACK": "1"}}
