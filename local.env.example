# Copy to local.env and fill in. Not committed: it holds the addresses of your installation.
KNOWLEDGE_FORGE_SSH=root@<docker host>          # where deploy.sh rsyncs and builds the server
KNOWLEDGE_VM_HOST=<nfs host>                     # the machine that exports the shared files (option A)
KNOWLEDGE_URL=http://<docker host>:8766          # the server on the LAN (watcher, UI smoke test)
KNOWLEDGE_MATRIX_URL=http://<homeserver>:8008    # weekly lint report
KNOWLEDGE_PROXY_IPS=<reverse proxy ip>           # trusted for X-Forwarded-* headers
KNOWLEDGE_ALLOWED_HOSTS=<public host>,<docker host>:8766,127.0.0.1:8766
KNOWLEDGE_MATRIX_ROOM=<room id>                    # room for the weekly lint report
KNOWLEDGE_NEW_MODEL_CMD=<command>                  # optional: agent-report.py runs it with cli:model for each new model, its output joins the Matrix message
KNOWLEDGE_KUMA_URL=<http://kuma:3001>             # optional: Uptime Kuma push heartbeat of the weekly jobs (watcher/kuma.py)
KNOWLEDGE_VM_HOME=/home/<user>                   # home folder on the NFS host (option A volumes in compose.yaml)
KNOWLEDGE_VM_CC_PREFIX=-home-<user>              # Claude Code's project-folder prefix there: the home path with / as -
KNOWLEDGE_ADMINS=<sign-in user name>             # web UI users with full access (comma-separated)
KNOWLEDGE_TEST_USER=<sign-in user name>          # an admin, for tests/ui_smoke.py
KNOWLEDGE_ZENDRIVER_MCP=http://<browser host>:3012/mcp   # optional: zendriver MCP for the lesson loop's web research (else WebSearch)
KNOWLEDGE_PUBLIC_URL=https://<public host>       # optional: the web UI link in the agents' instructions
KNOWLEDGE_LANGUAGE=en                            # en or nl: memo section names (## Status/## Stand) and server wording
KNOWLEDGE_RERANK_MODEL=                          # optional duplicate check: /models/<folder> made by server/export_reranker.sh; empty = off
KNOWLEDGE_WATCH_DEVICE=                          # token name whose sessions write memo files directly (watcher): they get the duplicate notice too
KNOWLEDGE_BUILTIN_PROJECTS=homelab               # the original installation: homelab,anpitek,trade
KNOWLEDGE_STT_URL=                               # optional: speaking in chats, an OpenAI-compatible /v1 speech-to-text server (docs/voice.md)
KNOWLEDGE_STT_LANGUAGE=                          # its language (en, nl, ...); empty = detect
KNOWLEDGE_STT_PROMPT=                            # names and terms it should spell right

# Memory roots that live on the server only but whose facts this machine can check (weekly memo check, comma-separated).
# KNOWLEDGE_REVIEW_REMOTE=my-memory
